# Copia este archivo como .env y completa los valores.
# Nunca subas .env al repositorio.
#
# En Netlify estas mismas variables se configuran en:
# Site configuration → Environment variables.
# La service key SOLO debe existir en el servidor (Netlify Functions).

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=

# Clave SECRETA (sb_secret_...). Solo para el servidor. Nunca en el navegador.
# Si el proyecto aún usa claves antiguas, aquí va la service_role.
SUPABASE_SECRET_KEY=

# Clave pública (sb_publishable_... o anon). Opcional: esta tienda no la usa
# en el navegador porque el catálogo se sirve desde /api/public/catalog.
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Sesión del panel
# ----------------------------------------------------------------------------
# Firma de la cookie de sesión (mínimo 32 caracteres).
# Genera una con: openssl rand -hex 32
SESSION_SECRET=

# Origen permitido para el panel (sin barra final).
ALLOWED_ORIGIN=

# ----------------------------------------------------------------------------
# Netlify
# ----------------------------------------------------------------------------
# Build hook para regenerar la tienda (Site settings → Build & deploy).
NETLIFY_BUILD_HOOK=

# ----------------------------------------------------------------------------
# Cloudflare Turnstile (captcha del login)
# ----------------------------------------------------------------------------
# Dashboard de Cloudflare → Turnstile → tu sitio.
# El secreto va SOLO en Netlify. La site key es pública: se compila en el panel.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ----------------------------------------------------------------------------
# Administrador inicial (solo para `npm run admin`)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
