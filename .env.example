# Copia este archivo como .env y completa los valores.
# Nunca subas .env al repositorio.

# Proyecto de Supabase
# Dashboard → tu proyecto → Settings → API Keys → pestaña "Project URL" / "API Keys"
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave SECRETA (empieza por sb_secret_...). Solo para el servidor.
# Si tu proyecto aún usa las claves antiguas, pega aquí la service_role.
SUPABASE_SECRET_KEY=

# Opcional: clave pública (sb_publishable_... o anon). El panel no la necesita.
# SUPABASE_ANON_KEY=

# Firma de la cookie de sesión (mínimo 32 caracteres)
# Genera una con: openssl rand -hex 32
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Origen permitido para el panel (sin barra final)
ALLOWED_ORIGIN=https://cueva-boutique.netlify.app

# Build hook de Netlify (Site settings > Build & deploy > Build hooks)
NETLIFY_BUILD_HOOK=

# Opcional: crear el administrador con `npm run admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
